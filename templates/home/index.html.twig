{% extends 'base.html.twig' %}

{% block title %}Liste des animaux
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<div class="row g-2">
			{% for animal in animals %}
				{% if animal.adoptable == 1 and animal.adoptant is null %}
					{% set border = "border-success border-4" %}
				{% elseif animal.adoptable == 0 %}
					{% set border = "border-danger border-4" %}
				{% else %}
					{% set border = "border-warning border-4" %}
				{% endif %}

				<div class="col-md-6">
					<div class="card {{ border }} h-100">
						<img src="{{ animal.img }}" , class="card-img-top">
						<div class="card-body">
							<h5 class="card-title mb-1">{{ animal.nom }}</h5>
							<h6 class="card-subtitle text-muted mb-2">{{ animal.age }}
								ans</h6>
							<p class="card-text">{{ animal.sexe }}</p>
						</div>
					</div>
				</div>
			{% else %}
				<p>Aucun animal trouvé.</p>
			{% endfor %}
		</div>
	</div>
{% endblock %}
